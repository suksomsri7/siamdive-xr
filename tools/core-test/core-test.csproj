<Project Sdk="Microsoft.NET.Sdk">
  <!--
    core-test — รันเทส EditMode ที่เป็น "pure logic" (ไม่แตะ UnityEngine) ด้วย dotnet บนเครื่องนี้
    เพราะเครื่องนี้ไม่มี Unity Editor และ 1 รอบ CI = ~35 นาที.

    ตรวจได้เฉพาะไฟล์ที่ลิสต์ไว้ข้างล่าง (Core ที่ไม่ใช้ UnityEngine + เทสของมัน)
    อย่างอื่นยังต้องรอ CI เหมือนเดิม. เพิ่มไฟล์ใหม่ = เพิ่ม Compile Include ที่นี่.

        dotnet run  -c Release  (project = tools/core-test)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>core-test</AssemblyName>
    <RootNamespace>DiveMap.CoreTest</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>9</LangVersion>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnitLite" Version="3.14.0" />
    <!-- SolidBoxes parses the CDN's .solids.json; Unity ships the same package. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup Label="Core (UnityEngine-free)">
    <Compile Include="UnityShim.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/ItemPicker.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/SeabedGeom.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/WebCoord.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/SculptCoord.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/MarineMath.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/DroneFlight.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/WarpSpawn.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/FishAssetPick.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/SolidBoxes.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/FleeMath.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/SpeciesGenome.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/SpeciesBehavior.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/MarineRouting.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/AppModes.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/ChromeInset.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/SwimStyle.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/CameraRange.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/TexTiers.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/TrashPhysics.cs" />
    <!-- WO-F2. The web's school system is slot-formation, not boids; the slot formulas, the
         speed law and the mode wheel are pure, so "does a fish that reached its slot slow down"
         is a 2-second answer here instead of a 35-minute CI round and a screenshot. -->
    <Compile Include="../../DiveMap/Assets/Scripts/Core/SchoolFormation.cs" />
    <!-- WO-F3. The clip rules (which clip, how fast, clip-or-wave) are pure so that "does it
         match the web's animRate" is a 2-second answer on this machine instead of a 35-minute
         CI round. The Unity half is Runtime/Marine/BodyClips.cs and cannot be tested here. -->
    <Compile Include="../../DiveMap/Assets/Scripts/Core/ClipPlay.cs" />
    <!-- SwimStyleTests asserts SwimStyle.UnitsPerMetre == DepthLight.UnitsPerMetre. Two metres in
         one project is what made every fin run √2 fast, so the two constants are now pinned to
         each other by a test rather than by a comment. DepthLight is pure (using System; only). -->
    <Compile Include="../../DiveMap/Assets/Scripts/Core/DepthLight.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/HuntMath.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/FishMind.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/QcPixels.cs" />
    <!-- WO-L. QcFidelity is the "did the renderer keep the texture's pattern" probe.
         Pure arithmetic on two byte buffers, and the one claim it exists to pin — a
         uniform additive wash leaves hpRms alone and still kills spotFrac — is a
         2-second answer here instead of a 35-minute CI round. -->
    <Compile Include="../../DiveMap/Assets/Scripts/Core/QcFidelity.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/GlbShading.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/FxRules.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/NormalMapDecode.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/GltfTextureRoles.cs" />
    <!-- WO-ASTC. Which GPU format a KTX2 is transcoded INTO. Pure, and the one claim worth
         pinning on this machine is negative: on a device with no ASTC (CI's llvmpipe is one)
         it must ask for nothing at all, because a rejected target format loses the texture. -->
    <Compile Include="../../DiveMap/Assets/Scripts/Core/KtxTranscodeTarget.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/AstcAssetPick.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/LoadProgress.cs" />
    <!-- WO-MERGE P1. The boot message from the React Native host. Pure (Newtonsoft only), and
         the failures it guards against are invisible from inside Unity: a misread payload opens
         the wrong dive site, or shows Unity's own map hub inside an app that already has one,
         and neither writes an error anywhere. -->
    <Compile Include="../../DiveMap/Assets/Scripts/Core/NativeBoot.cs" />
    <!-- WO-MERGE P1c. When to answer an iOS memory warning. The handler needs a device; the
         throttle rule is the part that can be wrong (answering a burst four times over is a
         freeze added to a phone that was only nearly out of memory) and it is pure. -->
    <Compile Include="../../DiveMap/Assets/Scripts/Core/MemoryRelief.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/MemoryReading.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/BootMode.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/EditAccess.cs" />
    <!-- WO-MERGE P1d. The dive-site GET URL. Pure, and the reason it is here is that a missing
         ?deviceId= on it made every map read-only for its own owner in both products. -->
    <Compile Include="../../DiveMap/Assets/Scripts/Core/SiteRequest.cs" />
    <!-- WO-MERGE P1e. The "is this frame a dead world" verdict behind the flat-navy positive
         control. The pixels come from CI; the judgement — including what to do when the bug
         fails to reproduce — is settled here. -->
    <Compile Include="../../DiveMap/Assets/Scripts/Core/QcBlank.cs" />
    <!-- WO-MERGE DARK. Which baseline a depth scaler may refresh. Pure, and the reason it is
         here is a number off the user's own screen: authored fog 500..9000, live 489..8797. -->
    <Compile Include="../../DiveMap/Assets/Scripts/Core/AtmosphereBaseline.cs" />
    <!-- WO-P. When the 26 MB of trash-game models may be fetched. Pure, and it is the guard on
         two costs this project has already been burned by: peak memory and map-load time. -->
    <Compile Include="../../DiveMap/Assets/Scripts/Core/GamePreload.cs" />
    <!-- P1h: the blank gate is pinned against the drone's REAL lights-off fog colour, so it can
         never again be set below the very thing it exists to detect. -->
    <Compile Include="../../DiveMap/Assets/Scripts/Core/DiveLightMath.cs" />
    <!-- WO-MERGE P1g. The auto-play gate, added here so the ordering rule that P1e depends on
         (exit any stale mode BEFORE the gate is consulted, never after) is pinned on this
         machine instead of only on CI. Both files are UnityEngine-free. -->
    <Compile Include="../../DiveMap/Assets/Scripts/Core/MapDirectory.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/ArenaEntry.cs" />
    <!-- WO-L. The palette IS the shop (placing = buying), so its rules are the ones where being
         wrong costs a player real coins: who pays (Shop.ShouldCharge — the admin never does),
         which chips exist (the 🌀 Warp category is admin-only), and what the coin pill says.
         Wallet comes along because Shop.Buy spends through it. All four are UnityEngine-free. -->
    <Compile Include="../../DiveMap/Assets/Scripts/Core/TrashGame.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/Wallet.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/Shop.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/Palette.cs" />
    <!-- WO-L item 8. The live /api/assets merge runs on a body from the network, so the cases
         that matter are the ugly ones — malformed JSON, an id in both sources, a clock that went
         backwards — and none of them may empty the palette. -->
    <Compile Include="../../DiveMap/Assets/Scripts/Core/AssetCatalog.cs" />
    <!-- WO-N item 4. Who counts as the admin. Believing the wrong evidence is silent and costs
         real coins in one direction and gives away a whole category in the other, and the rule
         is pure — Account itself needs PlayerPrefs and stays CI-only. -->
    <Compile Include="../../DiveMap/Assets/Scripts/Core/AdminIdentity.cs" />
    <!-- WO-O. The per-axis gizmo handles. A screenshot cannot tell a real X-only drag from a
         free drag that happened to move rightwards, and arrows that do not constrain "look
         right and lie" — so the constraint is arithmetic, checked here. SceneEdit comes along
         because ScaleAfterDrag clamps through it; both are UnityEngine-free. -->
    <Compile Include="../../DiveMap/Assets/Scripts/Core/SceneData.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/SceneEdit.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/GizmoMath.cs" />
    <!-- WO-Q. The two halves of "a QC shot has to prove it photographed its own subject": which
         runs the auto-tour may not hijack (it hijacked two instruments in one build), and the
         difference-frame arithmetic behind the arrows. Both are UnityEngine-free, and the case
         worth having on this machine is the negative one — an instrument that cannot say NO is
         how a picture of open water passed as a picture of three axis arrows. -->
    <Compile Include="../../DiveMap/Assets/Scripts/Core/QcAutoPlay.cs" />
    <Compile Include="../../DiveMap/Assets/Scripts/Core/QcShotProof.cs" />
  </ItemGroup>

  <ItemGroup Label="EditMode tests for exactly those files">
    <Compile Include="../../DiveMap/Assets/Tests/EditMode/WebCoordTests.cs" />
    <Compile Include="../../DiveMap/Assets/Tests/EditMode/MemoryReadingTests.cs" />
    <Compile Include="../../DiveMap/Assets/Tests/EditMode/BootModeTests.cs" />
