    <Compile Include="../../DiveMap/Assets/Tests/EditMode/FishMindTests.cs" />
    <Compile Include="../../DiveMap/Assets/Tests/EditMode/DroneFlightTests.cs" />
    <Compile Include="../../DiveMap/Assets/Tests/EditMode/WarpSpawnTests.cs" />
    <Compile Include="../../DiveMap/Assets/Tests/EditMode/FishAssetPickTests.cs" />
    <Compile Include="../../DiveMap/Assets/Tests/EditMode/SolidBoxesTests.cs" />
    <Compile Include="../../DiveMap/Assets/Tests/EditMode/TiltedHullTests.cs" />
    <Compile Include="../../DiveMap/Assets/Tests/EditMode/QcPixelsTests.cs" />
    <Compile Include="../../DiveMap/Assets/Tests/EditMode/QcFidelityTests.cs" />
    <Compile Include="../../DiveMap/Assets/Tests/EditMode/GlbShadingTests.cs" />
    <Compile Include="../../DiveMap/Assets/Tests/EditMode/FxRulesTests.cs" />
    <Compile Include="../../DiveMap/Assets/Tests/EditMode/NormalMapDecodeTests.cs" />
    <Compile Include="../../DiveMap/Assets/Tests/EditMode/GltfTextureRolesTests.cs" />
    <Compile Include="../../DiveMap/Assets/Tests/EditMode/KtxTranscodeTargetTests.cs" />
    <Compile Include="../../DiveMap/Assets/Tests/EditMode/AstcAssetPickTests.cs" />
